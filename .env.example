CANVAS_BASE_URL=https://reykjavik.instructure.com
CANVAS_TOKEN=paste-your-token-here
SCHOOL_ROOT=/Users/you/Documents/Tolvunarfraedi

# The term (Haustönn = autumn, Vorönn = spring) you started your studies in. Every "onn N"
# folder/semester number in the product is counted from this term, 1-based, two terms per
# year. Defaults to "Haustönn 2024" if unset.
FIRST_TERM=Haustönn 2024

# Currently required to start the server, but only actually used as a last-resort fallback
# (in search_materials) when a course's semester can't be derived from FIRST_TERM + its
# Canvas term at all. Any integer works if you're unsure.
CURRENT_SEMESTER=5
